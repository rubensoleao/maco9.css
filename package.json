{
  "name": "platinum.css",
  "version": "0.0.1",
  "description": "MacOS 9 inspired CSS UI library.",
  "main": "build/platinum.css",
  "author": "Mat Sz <contact@matsz.dev>",
  "keywords": [
    "css",
    "macos",
    "platinum",
    "ui",
    "retro"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/mat-sz/platinum.css.git"
  },
  "bugs": {
    "url": "https://github.com/mat-sz/platinum.css/issues"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "src/**/*.{js,jsx,ts,tsx,json,css,scss,md}": [
      "prettier --write"
    ],
    "build.js": [
      "prettier --write"
    ]
  },
  "scripts": {
    "build": "node build.js",
    "prepare": "npm run build",
    "dev": "gulp"
  },
  "homepage": "https://github.com/mat-sz/platinum.css",
  "license": "BSD-3-Clause-Clear",
  "devDependencies": {
    "browser-sync": "^3.0.4",
    "cssnano": "^7.1.2",
    "gulp": "^5.0.1",
    "gulp-postcss": "^10.0.0",
    "gulp-sass": "^6.0.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "mkdirp": "^3.0.1",
    "postcss": "^8.5.6",
    "postcss-calc": "^10.1.1",
    "postcss-copy": "^7.1.0",
    "postcss-css-variables": "^0.19.0",
    "postcss-inline": "^1.2.0",
    "postcss-inline-svg": "^6.0.0",
    "postcss-scss": "^4.0.9",
    "postcss-url": "^10.1.3",
    "prettier": "^3.7.4",
    "sass": "^1.97.1"
  }
}
